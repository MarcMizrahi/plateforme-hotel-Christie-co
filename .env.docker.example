# Variables utilisées par docker-compose.yml lui-même (substitution ${...}),
# distinct de .env (variables d'exécution de l'app, cf. .env.example).
# Ne jamais commiter le vrai .env.docker (déjà dans .gitignore).

POSTGRES_USER=hotelmarket
POSTGRES_PASSWORD="change-me-generate-with-openssl-rand-hex-24"
POSTGRES_DB=hotelmarket

# Domaine public (Caddy y obtient automatiquement un certificat HTTPS)
DOMAIN=monsite.example

# Image applicative publiée par la CI sur GHCR. `:latest` suit la branche main ;
# préférer un tag immuable (sha ou deploy-*) pour un rollback déterministe.
# Repo privé : `docker login ghcr.io` une fois sur le serveur (PAT scope read:packages).
APP_IMAGE=ghcr.io/marcmizrahi/plateforme-hotel-christie-co:latest
