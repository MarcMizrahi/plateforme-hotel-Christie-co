DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hotelmarket?schema=public"

# Nom de marque paramétrable (D1 non tranchée — cf. BRAND.md §2, DECISIONS.md)
NEXT_PUBLIC_BRAND_NAME="HotelMarket"

# Mot de passe unique de l'admin (Phase 0 : pas de compte, un mot de passe partagé)
ADMIN_PASSWORD="changeme"
ADMIN_SESSION_SECRET="change-me-to-a-random-string"

# SMTP (optionnel en dev — si absent, le rapport d'estimation est journalisé, pas envoyé)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@hotelmarket.example"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
